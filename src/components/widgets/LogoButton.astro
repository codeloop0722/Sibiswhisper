---
import Link from '~/components/base/Link.astro'
import { withBasePath } from '~/utils/path'
import { SITE } from '~/config'
---

<Link
  class="select-none op-transition"
  href={withBasePath('/')}
  aria-label={SITE.author}
  aria-current={Astro.url.pathname === `${withBasePath('/')}` ? 'page' : false}
>
  <div class="logo-container">
    <img src="/icon-192.png" alt={SITE.title} class="logo-img" />
  </div>
</Link>

<style>
  .logo-container {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;
  }
  /* 直接控制图片的实际大小 */
  .logo-img {
    width: 60px;       /* 修改这里的数值来调整大小 */
    height: auto;      /* 高度自适应，防止图片变形 */
    border-radius: 50%;
  }

  @media (max-width: 767.9px) {
    .logo-container {
      margin-top: 0.125rem;
    }
  }

    .logo-img {
      width: 32px;
      border-radius: 50%; 
    }
</style>
