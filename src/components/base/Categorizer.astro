---
import { slug } from '~/utils/toc'

interface Props {
  idx?: number
  text: string
  needId?: boolean
}

const { idx, text, needId = false } = Astro.props
---

<div
  {...needId ? { id: slug(text) } : {}}
  class={`toc-heading relative
    pointer-events-none select-none
    ${idx !== undefined ? 'slide-enter' : ''}`}
  style={idx !== undefined ? { '--enter-stage': idx - 2 } : undefined}
>
  <span class="inline-block mt-4 mb-3 text-xl font-800 op-60">
    {text}
  </span>
</div>
