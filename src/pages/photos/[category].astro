---
import BaseLayout from '~/layouts/BaseLayout.astro'
import StandardLayout from '~/layouts/StandardLayout.astro'
import PhotoView from '~/components/views/PhotoView.astro'

import { photoCategories } from '~/content/photos/categories'

export function getStaticPaths() {
  return Object.entries(photoCategories).map(([name, slug]) => ({
    params: { category: slug },
    props: { name, slug },
  }))
}

const { name, slug } = Astro.props
---

<BaseLayout title={name} description={`${name} 照片集`} ogImage={false}>
  <StandardLayout title={name} subtitle="照片集" isCentered={true}>
    <PhotoView category={name} id={slug} />
  </StandardLayout>
</BaseLayout>